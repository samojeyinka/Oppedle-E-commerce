<h1>Your Cart</h1>

<% if @cart_items.any? %>
  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Size</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Subtotal</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each do |cart_item| %>
        <tr>
          <td><%= cart_item.product.name %></td>
          <td><%= cart_item.size || "N/A" %></td>
          <td>₦<%= number_with_delimiter(cart_item.product.price, delimiter: ',') %></td>
          <td>
            <%= form_with url: cart_path, method: :patch, local: true do |f| %>
              <%= f.hidden_field :cart_item_id, value: cart_item.id %>
              <%= f.number_field :quantity, value: cart_item.quantity, min: 0, style: "width: 60px" %>
              <%= f.submit "Update" %>
            <% end %>
          </td>
          <td>₦<%= number_with_delimiter(cart_item.quantity * cart_item.product.price, delimiter: ',') %></td>
          <td>
            <%= form_with url: cart_path, method: :patch, local: true do |f| %>
              <%= f.hidden_field :cart_item_id, value: cart_item.id %>
              <%= f.hidden_field :quantity, value: 0 %>
              <%= f.submit "Remove" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p><strong>Total: ₦<%= number_with_delimiter(@cart_items.sum { |item| item.quantity * item.product.price }, delimiter: ',') %></strong></p>

  <%= link_to "Checkout", new_order_path %>
  <%= link_to "Clear Cart", cart_path, data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
<% else %>
  <p>Your cart is empty.</p>
<% end %>

<%= link_to "Continue Shopping", products_path %>