<section class="u-navbar">
    <div class="u-navbar-flex">
        <%= link_to root_path do %>
        <div class="navbar-logo-box">

            <i class="fa fa-shopping-basket text-blue-800" aria-hidden="true"></i>
                <span class="text-blue-800 text-base font-extrabold">Oppedle</span>

        </div>
        <% end %>
      <div class="px-2 bg-gray-50 w-full md:w-1/2 rounded-full">
  <div class="flex items-center gap-2 w-full">
    <i class="fa fa-search text-gray-400" aria-hidden="true"></i>

    <%= form_with url: "#", method: :get, class: "flex-1" do |form| %>
      <%= form.search_field :query,
            placeholder: "Search for products, brands and more...",
            class: "w-full bg-transparent text-[13px] border-none outline-none focus:outline-none focus:ring-0"
 %>
    <% end %>
  </div>
</div>

        <ul class="u-navbar-links font-semibold">

        <li class="nav_link">
        <%= link_to "Shop", root_path
 %>
        </li>

            <li class="nav_link">
        <%= link_to "Deals", root_path
 %>
        </li>

            <li class="nav_link">
        <%= link_to "What's New", root_path
 %>
        </li>

            <li class="nav_link">
            <%= link_to root_path do %>
        <i class="fa-solid fa-heart" aria-hidden="true"></i>
        <% end %>
        </li>

         <li class="nav_link">
            <%= link_to root_path do %>
       <i class="fa-solid fa-shopping-cart" aria-hidden="true"></i>
        <% end %>
        </li>

        <li class="nav_link">
            <%= link_to root_path do %>
       <i class="fa-solid fa-user" aria-hidden="true"></i>
        <% end %>
        </li>

        </ul>
    </div>
</section>
